{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "varnika-console",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "varnika-console"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "r2_buckets": [
    { "binding": "CATALOG_BUCKET", "bucket_name": "catalog" },
    { "binding": "CUSTOMERDATA_BUCKET", "bucket_name": "customerdata" }
  ]
}
